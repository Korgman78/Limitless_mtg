{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Reutilisation de la logique pure de Limitless */
    "baseUrl": ".",
    "paths": {
      "@limitless/*": ["../src/*"]
    }
  },
  "include": ["src", "../src/utils/deckAnalysisCore.ts", "../src/utils/helpers.ts", "../src/types.ts"]
}
